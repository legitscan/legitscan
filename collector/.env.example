# Usually not needed: Chainstack / Alchemy go in the global ~/.config/tech-coin/secrets.env, used by every project.
# Use this file only to override for LegitScan. Copy to .env (same folder) and fill in. .env is git-ignored and never printed by the collector.
# Several nodes = more requests per minute. Separate with commas. Empty = the free public node.

# Any node: contract reads, balances, block numbers.
RPC_URLS=

# Nodes that can read OLD event logs (Pons launches, dev wallet history). The public node can.
# Leave a node out if its plan only reads recent blocks.
LOGS_RPC_URLS=https://rpc.mainnet.chain.robinhood.com
